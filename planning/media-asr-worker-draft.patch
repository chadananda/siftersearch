+def asrworker_status(name, job=None, since=None):
+    tmp = f'asr-worker.{name}.json.tmp'
+    with open(tmp, 'w') as f:
+        json.dump({'pid': os.getpid(), 'name': name, 'beat': time.time(), 'resident': bool(_asr_models), 'job': job, 'since': since}, f)
+    os.replace(tmp, f'asr-worker.{name}.json')
+
+
+def asrworker_claim(spool, name):
+    """The oldest QUEUED job, claimed by an atomic rename (two workers never take the same one). → its dir or None"""
+    import glob
+    for qf in sorted(glob.glob(os.path.join(spool, '*', 'queued')), key=lambda f: os.path.getmtime(f) if os.path.exists(f) else 0):
+        d = os.path.dirname(qf)
+        try:
+            os.rename(qf, os.path.join(d, 'claimed'))
+        except OSError:
+            continue
+        with open(os.path.join(d, 'claimed'), 'w') as f:
+            json.dump({'pid': os.getpid(), 'name': name, 'at': time.time()}, f)
+        return d
+    return None
+
+
+def asrworker_run(d, parser, transcribe=None):
+    """One claimed job: its args (args.json, as the per-process command line after 'transcribe') through cmd_transcribe on the
+    resident models. Out of GPU memory → models unloaded and the job handed to the per-process path ('fallback'); another
+    error → 'failed' with err.txt. The claim is always released."""
+    transcribe = transcribe or cmd_transcribe
+    out_old, err_old = sys.stdout, sys.stderr
+    sys.stdout = open(os.path.join(d, 'summary.json'), 'w')
+    sys.stderr = open(os.path.join(d, 'err.txt'), 'a')
+    try:
+        args = json.load(open(os.path.join(d, 'args.json')))
+        transcribe(parser.parse_args(['transcribe'] + args))
+        return 'done'
+    except BaseException as err:
+        import traceback
+        traceback.print_exc()
+        if 'out of memory' in str(err).lower():
+            unload_models()
+            open(os.path.join(d, 'fallback'), 'w').close()
+            return 'fallback'
+        open(os.path.join(d, 'failed'), 'w').close()
+        return 'failed'
+    finally:
+        sys.stdout.close(); sys.stderr.close()
+        sys.stdout, sys.stderr = out_old, err_old
+        try:
+            os.remove(os.path.join(d, 'claimed'))
+        except OSError:
+            pass
+
+
+def cmd_asrworker(a):
+    """THE PERSISTENT TRANSCRIPTION WORKER (MEDIA_ASR_RESIDENT=1; started and watched by the gate): claims queued jobs from
+    --spool, runs them on resident models, unloads them after --idle-unload seconds without a job. Exits (the gate falls back
+    to per-process jobs) when the GPU is not available — never transcribes on a CPU."""
+    parser = build_parser()
+    if device()[0] != 'cuda':
+        print('asrworker: no GPU — exiting (per-process jobs take over)', file=sys.stderr)
+        return
+    last = time.time()
+    while not os.path.exists('asr-worker.stop'):
+        asrworker_status(a.name)
+        d = asrworker_claim(a.spool, a.name)
+        if not d:
+            if _asr_models and time.time() - last > a.idle_unload:
+                unload_models()
+            time.sleep(1)
+            continue
+        asrworker_status(a.name, job=os.path.basename(d), since=time.time())
+        r = asrworker_run(d, parser)
+        print(f'{time.strftime("%H:%M:%S")} {os.path.basename(d)} {r}', file=sys.stderr, flush=True)
+        last = time.time()
+
+
