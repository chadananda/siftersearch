+def asr_model(whisperx, a, dev, ct, asr_opts, multi):
+    if not RESIDENT:
+        return whisperx.load_model(a.model, dev, compute_type=ct, language=None if multi else (a.lang or None), asr_options=asr_opts,
+                                   vad_method='silero', threads=a.threads)
