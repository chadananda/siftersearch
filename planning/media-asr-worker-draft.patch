+        m = whisperx.load_model(a.model, dev, compute_type=ct, language=None, asr_options=asr_opts, vad_method='silero', threads=a.threads)
+        _asr_models[key] = m
+    else:           # this job's prompt (vocabulary) on the resident pipeline
+        m.options = dataclasses.replace(m.options, initial_prompt=asr_opts.get('initial_prompt'))
+    return m
+
