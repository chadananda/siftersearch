+def align_model(whisperx, lang, dev):
+    if not RESIDENT:
+        return whisperx.load_align_model(language_code=lang, device=dev)
+    if lang not in _align_models:
+        _align_models[lang] = whisperx.load_align_model(language_code=lang, device=dev)
+    return _align_models[lang]
+
