---
// SourceHunt: paste an English quotation → the published book it comes from, every publication citing it, and the original
// Arabic/Persian tablet (Ocean of Lights / Phelps Inventory). Full-width console; the hunt streams from the API.
import Layout from '../layouts/Layout.astro';
import NavBar from '../components/common/NavBar.svelte';
import SourceHunt from '../components/SourceHunt.svelte';
---

<Layout title="SourceHunt — trace a quotation to its source" description="Paste a quotation in English to find the book it was published in, every publication that cites it, and the original Arabic or Persian tablet.">
  <NavBar client:idle currentPage="sourcehunt" />
  <main class="mx-auto w-full max-w-[1800px] px-4 py-6 sm:px-6 lg:px-10 lg:py-10">
    <SourceHunt client:load />
  </main>
</Layout>
