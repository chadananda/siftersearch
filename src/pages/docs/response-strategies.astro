---
// /docs/response-strategies — layer 2 of 3 (Tools → Response Strategies → Activities), from GET /api/v1/anis/strategies
// (edge-cached). Intro + improvement loop, the cost ladder, ONE accordion of strategies (#strategy-<id>; built first, then planned,
// Unmatched last; the plan's A1–H2 ids survive only as anchors #class-<id>; a hash of an id, a name or a class opens its item), the code
// building steps (#step-<name>), composition, decisions. The whole list comes from the strategy database (strategies + strategy_specs).
// Every number carries data-live and refreshes through liveRefresh (src/lib/anis-docs.js); SSR reserves its space.
import DocsLayout from '../../layouts/DocsLayout.astro';
import StrategyCanvas from '../../components/anis/StrategyCanvas.svelte';
import { strategiesFlat, show } from '../../lib/anis-docs.js';
import { titleOf, taglineOf, groupOf, GROUPS, orderedSteps, outcomeOf, targetsOf, MODES, MODE_NOTES } from '../../lib/strategy-docs.js';

const API_BASE = import.meta.env.PUBLIC_API_URL || 'https://api.siftersearch.com';
const soft = (path, ms) => fetch(`${API_BASE}${path}`, { signal: AbortSignal.timeout(ms) }).then((r) => (r.ok ? r.json() : null)).catch(() => null);
const data = await soft('/api/v1/anis/strategies', 8000);
if (data) Astro.response.headers.set('Cache-Control', 'public, s-maxage=120, stale-while-revalidate=600');
const m = strategiesFlat(data);
const strategies = data?.strategies || [];
const sorted = [...strategies].sort((x, y) => GROUPS.findIndex((g) => g.key === groupOf(x)) - GROUPS.findIndex((g) => g.key === groupOf(y)));
const oneLine = (s) => { const t = String(s || '').split(/\s[—–]\s|;\s|\.\s/)[0]; return t.length > 150 ? `${t.slice(0, 147)}…` : t; };
const label = (s) => (s === 'other' ? 'unmatched' : s);   // logs from before the rename say 'other'
const badge = (s) => (s.name === 'unmatched' ? 'unmatched' : s.where === 'shared-reply' ? 'in unmatched' : s.status);
const branchText = (b) => b.branch.map((p) => p.replace(/:([^:]*)$/, ' → $1')).join(' · ');
const plan = data?.plan || null;
const steps = data?.steps || [];
const nameOf = new Map(strategies.flatMap((x) => x.patterns.map((p) => [p.id, p.name])));
const stepGroups = [...new Set(steps.map((a) => a.name.split('.')[0]))];
const GROUP_TITLE = { respond: 'Reply steps', strategy: 'Strategy executors', ui: 'Reader interface' };
---

<DocsLayout title="Response Strategies" description="How the Ocean AI Research Assistant chooses a way to answer each question, and how those strategies are measured and improved" activeSection="response-strategies">
  <h1>Response Strategies</h1>
  <p class="subtitle">How the Ocean AI Research Assistant decides how to answer, and how it gets better at it</p>

  <section id="intro">
    <h2>What a strategy is</h2>
    <p>
      A <strong>response strategy</strong> is a fixed way of answering one kind of request, worked out in advance and tuned
      for speed and quality. Strategies range from simple to elaborate:
    </p>
    <ul>
      <li><em>"Where does Bahá'u'lláh say '…'?"</em>: find the passage and name its source.</li>
      <li><em>"Give me a timeline of 'Abdu'l-Bahá's travels, with the major talks marked."</em></li>
      <li><em>"Build me a compilation of everything 'Abdu'l-Bahá says about taxation, with translations side by side where the original is not in English."</em></li>
    </ul>
    <p>
      Each strategy is a decision tree. Its steps are <a href="#building-steps">building steps</a>: small pieces of code that
      each do one thing, most of them one use of a <a href="/docs/anis-tools">tool</a> (find a named book, trace a quotation,
      search the original-language tablets, write the reply). The tree itself is data, kept in a database, so a strategy can be
      added, changed, measured and rolled back without releasing new code. <a href="/docs/anis-activities">Activities</a>, such
      as reading a book together, reuse the same strategies.
    </p>
    <p>
      For each message, Jev, a fast decision model, reads the conversation and picks the strategy that fits. From there the
      strategy runs its steps.
    </p>

    <h2>How strategies improve</h2>
    <p>
      The strategies are not fixed. A measurement and improvement loop runs alongside them:
    </p>
    <ul>
      <li><strong>Every step is measured.</strong> Each step of each strategy records how long it took, what it cost and which way it branched, so every strategy and every path through it has its own numbers.</li>
      <li><strong>Every reply is judged.</strong> A separate judge model scores replies and names what went wrong, so quality joins speed and cost in the numbers below.</li>
      <li><strong>Gaps become candidates.</strong> When a kind of question is not served well by any strategy, a stronger model designs a candidate strategy from the existing building steps.</li>
      <li><strong>Candidates must win.</strong> A candidate is replayed on fresh questions of that class plus a set of guard questions. It is promoted only if it measurably wins, and the old version is kept so a promotion can be rolled back.</li>
      <li><strong>Weak steps get the same treatment.</strong> A step or branch that scores poorly gets candidate edits, which are replayed and promoted the same way.</li>
      <li><strong>Code problems go to engineers.</strong> Weaknesses that a strategy cannot fix (a building step, a tool, a search index) become recommendations for the engineers.</li>
    </ul>

    <svg class="flow" viewBox="0 0 760 120" role="img" aria-label="The improvement loop: question, Jev picks a strategy, the steps run and are measured, the judge scores the reply, a candidate is designed and replayed, and promoted only if it wins">
      <defs><marker id="arr" viewBox="0 0 10 10" refX="9" refY="5" markerWidth="7" markerHeight="7" orient="auto-start-reverse"><path d="M0,0 L10,5 L0,10 z" class="fill-muted" /></marker></defs>
      {[['Question', 0], ['Jev picks a strategy', 1], ['Steps run, measured', 2], ['Judge scores reply', 3], ['Candidate designed, replayed', 4]].map(([t, i]) => (
        <g>
          <rect x={8 + i * 150} y="16" width="132" height="44" rx="8" class="fill-surface-1 stroke-border" />
          <text x={74 + i * 150} y="43" text-anchor="middle" class="fill-primary">{t}</text>
          {i < 4 && <path d={`M${140 + i * 150},38 L${156 + i * 150},38`} class="stroke-muted" marker-end="url(#arr)" />}
        </g>
      ))}
      <path d="M674,60 C674,108 224,108 224,64" class="stroke-accent" fill="none" marker-end="url(#arr)" />
      <text x="450" y="112" text-anchor="middle" class="fill-accent">promoted only if it wins; the old version is kept</text>
    </svg>

    <p class="numbers">
      <span><strong data-live="summary.active" data-fmt="n">{show(m, 'summary.active')}</strong> active strategies</span>
      <span><strong data-live="summary.candidates" data-fmt="n">{show(m, 'summary.candidates')}</strong> candidates under replay</span>
      <span><strong data-live="summary.promotions_30d" data-fmt="n">{show(m, 'summary.promotions_30d')}</strong> promotions in the last 30 days</span>
    </p>
    <p class="note">
      Each step names a <a href="#building-steps">building step</a>; building steps call the <a href="/docs/anis-tools">tools</a>.
      The numbers below cover the last 7 days. The judge score is out of 10 and is the mean of the replies that have one.
    </p>
  </section>

  {plan && (
    <section id="ladder">
      <h2>How a strategy is built</h2>
      <p>
        Building a strategy starts with a pattern: a kind of request readers keep making, and the answer they want. That answer
        is turned into a reusable decision tree made of four kinds of step, each roughly ten times slower than the one before:
      </p>
      <ol>
        <li><strong>Code</strong>: plain program logic, such as matching a reference or ordering passages.</li>
        <li><strong>Tool calls</strong>: a search, a book lookup, a fetch of the original text.</li>
        <li><strong>Jev decisions</strong>: small judgments such as "was it found?", "is this enough?" or "which person is meant?"</li>
        <li><strong>Language-model calls</strong>: fast models only, and only for what the cheaper kinds cannot do, such as writing the reply.</li>
      </ol>
      <p>
        A step uses the fastest kind that can do its job. Every step is logged and measured, so each strategy can be made faster
        and better one step at a time.
      </p>
      <p>
        When no strategy fits a request, it goes to <a href="#strategy-respond">Unmatched</a>, the last entry in the list. A capable
        model answers it and designs a candidate strategy for it. That question becomes material for a new strategy, so the list
        grows to cover what readers actually ask, and the answers keep improving.
      </p>
      <div class="scroll">
        <table>
          <thead><tr><th>Tier</th><th>Cost</th><th>Used for</th></tr></thead>
          <tbody>{plan.ladder.map((l) => <tr><td><strong>{l.step}</strong></td><td class="nowrap">{l.cost}</td><td>{l.examples}</td></tr>)}</tbody>
        </table>
      </div>
      <p class="note">Target times: a book, quote or reference ≤ 1 s · other lookups ≤ 3 s · understanding and comparing ≤ 12 s, first words within 2 s · assignments take minutes, with progress shown.</p>
      <ul>
        <li><strong>Jev</strong>, the fast decision model (about 50 ms), reads each message with its thread and names its strategy: a lead strategy and any others. Jev also makes the small yes/no decisions inside a strategy (found? enough? which person?). Jev is never trained: each decision comes with the information it needs, and that context is adjusted until he decides right.</li>
        <li><strong>Tiers.</strong> The first tier uses only code, tools and Jev. A tier adds a light LLM step only when code cannot do the job, and only after the cheaper tier failed. If every tier fails, the research agent takes the question.</li>
        <li><strong>One writing step, for every answer.</strong> The chosen format shapes the answer; the writing model writes it once, adapting the evidence to Anís's voice and the reader, so answers stay varied and never sound canned. Lookups (find a book, trace a quote, a reference) go through a light writer too, so they stay fast.</li>
        <li><strong>Switched on only when it matches the agent.</strong> Each strategy is measured on fresh questions of its kind, with a held-out set kept aside, against the research agent's answers. It goes live for its class only when it matches or beats the agent within its target time. Until then the agent answers.</li>
      </ul>
      {plan.grounding_scale && (
        <p class="note">
          <strong>Grounding</strong> is how many real test questions a strategy has to measure it with (lead · also). The labels are only
          test fixtures for measuring Jev's choices:
          {Object.entries(plan.grounding_scale).map(([k, v], i) => <>{i > 0 && ' · '}<span class={`chip g-${k}`}>{k}</span> {v}</>)}.
        </p>
      )}
    </section>
  )}

  <section id="strategies-list">
    <h2>The strategies</h2>
    <p>
      One list, kept in the strategy database. Open an entry to see what Jev reads, the questions it answers, how its answers are
      shaped, its decision tree and its numbers. A <strong>live</strong> strategy runs today. A <strong>planned</strong> one is a kind of request readers keep
      making, with its test questions, target time and the answer we want, but no decision tree yet; until it has one, those
      questions go to <a href="#strategy-respond">Unmatched</a>. Some live strategies run inside the shared reply for now; they say so.
    </p>
    {!data && <p class="note">The strategy list could not be loaded just now. It will appear on the next visit.</p>}
    <p class="numbers">
      <span><strong>{strategies.filter((x) => x.status === 'built').length}</strong> built</span>
      <span><strong>{strategies.filter((x) => x.status === 'planned').length}</strong> planned</span>
    </p>
    <div id="strategies" class="cards">
      {sorted.map((s, idx) => {
        const un = s.name === 'unmatched';
        const g = groupOf(s);
        const tag = taglineOf(s);
        const unmatched = strategies.find((x) => x.name === 'unmatched');
        const tree = s.graph ? orderedSteps(s.graph) : [];
        const lead = s.patterns.find((p) => p.ideal_answer);
        return (
          <>
            {(idx === 0 || groupOf(sorted[idx - 1]) !== g) && <h3 class="group">{GROUPS.find((x) => x.key === g).label}</h3>}
            <details class="card" id={`strategy-${s.id}`} data-name={label(s.name).toLowerCase()}>
              <summary>
                {s.patterns.map((p) => <span id={`class-${p.id}`} class="anchor"></span>)}
                <span class="chev" aria-hidden="true"></span>
                <span class="title">{titleOf(s)}</span>
                <span class={`tagline${tag.quote ? ' quote' : ''}`}>{tag.text}</span>
                <span class={`chip st-${un ? 'unmatched' : s.where === 'shared-reply' ? 'shared' : s.status}`}>{badge(s)}</span>
                <span class="keys">
                  {s.graph && <>p50 <strong data-live={`s.${s.id}.p50_ms`} data-fmt="ms">{show(m, `s.${s.id}.p50_ms`, 'ms')}</strong> · <strong data-live={`s.${s.id}.score`} data-fmt="score">{show(m, `s.${s.id}.score`, 'score')}</strong></>}
                </span>
              </summary>
              <div class="body">

                <h3 class="first">The card: what Jev reads</h3>
                <div class="jevcard">
                  {s.where === 'shared-reply' ? (
                    <>
                      <p class="lead"><strong>{s.name}</strong> is not a separate option for Jev yet. He sends these messages to Unmatched, whose option reads:</p>
                      <p><code>unmatched</code> <span class="optext">{unmatched?.description}</span></p>
                    </>
                  ) : s.status === 'planned' ? (
                    <>
                      <p class="lead">Not one of Jev's options yet. The answer drafted for it:</p>
                      <p class="optext">{lead?.ideal_answer || s.description}</p>
                    </>
                  ) : (
                    <p><code>{label(s.name)}</code> <span class="optext">{s.description}</span></p>
                  )}
                  <p class="foot">Jev reads the conversation and picks the option that fits the latest message; below 60% confidence the message goes to Unmatched.</p>
                </div>
                {s.where === 'shared-reply' && (
                  <p class="note">It runs inside <a href={`#strategy-${s.inside.strategy}`}>{label(s.inside.name)}</a> as the steps {s.inside.nodes.map((n, i) => <>{i > 0 && ', '}<code>{n}</code></>)}.</p>
                )}

                <h3>Questions it answers</h3>
                {un && (
                  <p>
                    Everything no other strategy names. It first checks, quickly, whether Jev missed a strategy that fits. If none does, a smart model
                    answers in full and designs a candidate strategy for the question from the existing <a href="#building-steps">building steps</a>.
                    The candidate is replayed on fresh questions of the same kind and joins the list only if it wins; see <a href="#intro">how strategies improve</a>.
                    {s.where !== 'shared-reply' && ' Until a candidate exists, it runs the shared reply: the lookups listed above as built into it, then the research agent.'}
                  </p>
                )}
                {s.exemplars.length > 0 && <ul class="quotes">{s.exemplars.map((e) => <li>{e}</li>)}</ul>}
                {s.patterns.map((c) => (
                  <div class="pattern">
                    <p class="plead"><strong>{c.name}.</strong> {c.sounds_like.length > 0 ? 'Sounds like:' : ''}</p>
                    {c.sounds_like.length > 0 && <p class="chips">{c.sounds_like.map((q) => <span class="qchip">“{q}”</span>)}</p>}
                    {c.jev?.near_misses?.length > 0 && (
                      <>
                        <p class="plead"><em>Not this:</em></p>
                        <ul class="misses">{c.jev.near_misses.map((n) => (
                          <li>“{n.text}” → {targetsOf(n.goes_to).map((x, i) => <>{i > 0 && ' + '}<a href={`#class-${x}`}>{nameOf.get(x) || x}</a></>)}{n.why && <>: {n.why}</>}</li>
                        ))}</ul>
                      </>
                    )}
                    {(c.how_often || c.test_questions) && (
                      <p class="note">{c.how_often}{c.test_questions && <>{c.how_often && ' · '}test questions: {c.test_questions.lead ?? 0} lead · {c.test_questions.also ?? 0} also</>}</p>
                    )}
                  </div>
                ))}
                {s.patterns.length === 0 && (s.tests.lead + s.tests.also) > 0 && <p class="note">Test questions: {s.tests.lead.toLocaleString('en-US')} lead · {s.tests.also.toLocaleString('en-US')} also.</p>}

                <h3>How the answer is optimized</h3>
                {s.patterns.filter((c) => c.ideal_answer || c.route.length > 0).map((c) => (
                  <div class="pattern">
                    {s.patterns.length > 1 && <p class="plead"><strong>{c.name}</strong></p>}
                    {c.ideal_answer && <div class="callout"><span class="calloutlabel">The answer we want</span>{c.ideal_answer}</div>}
                    {c.route.length > 0 && <ol class="route">{c.route.map((r) => <li>{r.jev && <span class="chip jevchip">Jev</span>} {r.text}</li>)}</ol>}
                    <p class="facts">
                      {(c.target_time || s.target_time) && <span><b>Target time</b> {c.target_time || s.target_time}</span>}
                      {c.format && <span><b>Format</b> {c.format}</span>}
                      {c.post && <span><b>Then</b> {c.post}</span>}
                    </p>
                  </div>
                ))}
                {un && <p>Unmatched has no single ideal answer: the answer is whatever the question needs, written in full by a strong model. Its route is the decision tree below.</p>}
                {!un && !s.patterns.some((c) => c.ideal_answer || c.route.length > 0) && <p class="note">No route is written down for this one yet.</p>}

                <h3>By mode</h3>
                <p>{MODES.sameEverywhere}</p>
                <div class="modes">
                  {[MODES.audio, MODES.chat, MODES.email].map((md) => (
                    <div class="mode">
                      <p class="modehead"><strong>{md.name}</strong> <span class={`chip ${md.live ? 'st-built' : 'st-planned'}`}>{md.live ? 'Live' : 'Not yet'}</span></p>
                      <ul>{md.lines.map((l) => <li>{l}</li>)}</ul>
                    </div>
                  ))}
                </div>
                {MODE_NOTES[s.name] && <p class="note">{MODE_NOTES[s.name]}</p>}

                <h3>Decision tree</h3>
                {s.graph ? (
                  <>
                    <StrategyCanvas client:only="svelte" name={s.id} />
                    <p class="note">Click a step for its prompt, parameters and numbers. The same tree as a list:</p>
                    <ol class="tree">
                      {tree.map((n) => (
                        <li id={`node-${s.id}-${n.id}`}>
                          <span class="num">{n.n}</span>
                          <span class="stephead"><a class="stepname" href={`#step-${n.activity}`}>{n.label}</a> <span class={`chip kind-${n.kind}`}>{n.kind}</span></span>
                          <span class="exits">{n.exits.map((e, i) => <>{i > 0 && ' · '}{e.on} → {e.end ? 'end' : <a href={`#node-${s.id}-${tree.find((x) => x.n === e.to)?.id}`}>{e.to}. {e.toLabel}</a>}</>)}</span>
                        </li>
                      ))}
                    </ol>
                    {tree.length === 1 && <p class="note">The whole strategy runs as one coded step today; its route is described above.</p>}
                    {s.templates.length > 0 && <p class="note">Writer templates: {s.templates.map((t) => <code>{t.id}@{t.version}</code>)}</p>}
                  </>
                ) : s.where === 'shared-reply' ? (
                  <p class="note">No tree of its own yet: it runs inside the shared reply (see the card above).</p>
                ) : <p class="note">No decision tree yet; these questions go to <a href="#strategy-respond">Unmatched</a> until one is built.</p>}

                {s.graph && (
                  <>
                    <h3>Statistics: last 7 days</h3>
                    <div class="tiles">
                      {[['Turns', 'turns', 'n'], ['Share of turns', 'share', 'share'], ['p50', 'p50_ms', 'ms'], ['p95', 'p95_ms', 'ms'], ['Judge score', 'score', 'score'], ['Scored replies', 'n_scored', 'n'], ['Weak', 'weak_pct', 'pct'], ['Cost per turn', 'usd_per_turn', 'usd']].map(([t, k, f]) => (
                        <div class="tile"><span class="tl">{t}</span><strong data-live={`s.${s.id}.${k}`} data-fmt={f}>{show(m, `s.${s.id}.${k}`, f)}</strong></div>
                      ))}
                    </div>
                    <h4>Branches</h4>
                    {s.branches.length ? (
                      <div class="scroll"><table>
                        <thead><tr><th>Path taken</th><th>Share</th><th>p50</th><th>Score</th></tr></thead>
                        <tbody>
                          {s.branches.map((b) => (
                            <tr><td class="path">{branchText(b)}</td>
                              <td data-live={`b.${s.id}.${b.hash}.share`} data-fmt="share">{show(m, `b.${s.id}.${b.hash}.share`, 'share')}</td>
                              <td data-live={`b.${s.id}.${b.hash}.p50_ms`} data-fmt="ms">{show(m, `b.${s.id}.${b.hash}.p50_ms`, 'ms')}</td>
                              <td data-live={`b.${s.id}.${b.hash}.score`} data-fmt="score">{show(m, `b.${s.id}.${b.hash}.score`, 'score')}</td></tr>
                          ))}
                        </tbody>
                      </table></div>
                    ) : <p class="note">No measured turns in the last 7 days.</p>}

                    <h3>Versions</h3>
                    <p>Current version <strong>v{s.version}</strong>.</p>
                    {s.candidates.length ? (
                      <div class="scroll"><table>
                        <thead><tr><th>Version</th><th>Status</th><th>Created</th><th>Outcome</th><th>Mean score: candidate vs current</th></tr></thead>
                        <tbody>
                          {s.candidates.map((c) => (
                            <tr><td>v{c.version}</td><td>{c.status}</td><td class="nowrap">{String(c.created_at || '').slice(0, 10) || '–'}</td>
                              <td>{outcomeOf(c)}</td>
                              <td class="nowrap">{c.replay?.numbers?.mean_candidate != null ? `${c.replay.numbers.mean_candidate} vs ${c.replay.numbers.mean_current}` : '–'}
                                <span data-live={`c.${s.id}.${c.version}.score`} data-fmt="score" hidden>{show(m, `c.${s.id}.${c.version}.score`, 'score')}</span></td></tr>
                          ))}
                        </tbody>
                      </table></div>
                    ) : <p class="note">No candidate versions at the moment.</p>}
                  </>
                )}

                {s.patterns.some((c) => c.tiers.length || c.jev || c.measure || c.open_questions.length || c.test_questions?.examples?.length) && (
                  <details class="notes">
                    <summary>Design notes</summary>
                    {s.patterns.map((c) => (
                      <div class="pattern">
                        <p class="plead"><strong>{c.name}</strong></p>
                        {c.often_with && <p class="note">Often with: {c.often_with}</p>}
                        {c.sounds_like_note && <p class="note">{c.sounds_like_note}</p>}
                        {c.test_questions?.examples?.length > 0 && <p class="note">Test questions{c.test_questions.derived && ` (${c.test_questions.derived})`}: {c.test_questions.examples.map((q) => `“${q}”`).join(' · ')}</p>}
                        {c.tiers.length > 0 && (
                          <>
                            <h4>Steps by tier</h4>
                            <table class="tiers"><tbody>
                              {c.tiers.map((t) => (
                                <tr><th>{t.cost}</th><td>{t.steps.map((st, i) => <>{i > 0 && ' · '}{st.href ? <a href={st.href}>{st.label}</a> : st.label}</>)}</td></tr>
                              ))}
                            </tbody></table>
                          </>
                        )}
                        {c.jev && (
                          <>
                            <h4>How Jev tells it apart</h4>
                            <dl>
                              {c.jev.cues?.length > 0 && (<><dt>Cues</dt><dd>{c.jev.cues.join(' · ')}</dd></>)}
                              {c.jev.required_slots?.length > 0 && (<><dt>Needs</dt><dd>{c.jev.required_slots.join(' · ')}</dd></>)}
                              {c.jev.disqualifiers?.length > 0 && (<><dt>Not when</dt><dd>{c.jev.disqualifiers.join(' · ')}</dd></>)}
                              {c.jev.confusable_with?.length > 0 && (<><dt>Confused with</dt><dd>{c.jev.confusable_with.map((x, i) => <>{i > 0 && ' · '}<a href={`#class-${x}`}>{nameOf.get(x) || x}</a></>)}</dd></>)}
                              {c.jev.composes_with?.length > 0 && (<><dt>Combines with</dt><dd>{c.jev.composes_with.map((x, i) => <>{i > 0 && ' · '}<a href={`#class-${x}`}>{nameOf.get(x) || x}</a></>)}</dd></>)}
                            </dl>
                            {c.jev.example_phrasings?.length > 0 && <p class="note">Example phrasings: {c.jev.example_phrasings.map((q) => `“${q}”`).join(' · ')}</p>}
                          </>
                        )}
                        {c.measure && (<><h4>Measure</h4><p>{c.measure}</p></>)}
                        {c.open_questions.length > 0 && (<><h4>Open questions</h4><ul>{c.open_questions.map((q) => <li>{q}</li>)}</ul></>)}
                      </div>
                    ))}
                  </details>
                )}
              </div>
            </details>
          </>
        );
      })}
    </div>
  </section>

  <section id="building-steps">
    <h2>Building steps</h2>
    <p>
      The code every strategy graph is made of. Each step does one thing: a tool call, a decision by Jev, a transform of what
      has been gathered, the writer, or a check. New strategies are composed from these steps without changing any code; a new
      step is new code, with its own test. Runs, p50 and cost cover the last 7 days.
    </p>
    {!data && <p class="note">The step list could not be loaded just now.</p>}
    <div class="scroll">
      <table class="steps">
        <thead><tr><th>Step</th><th>Tier</th><th>What it does</th><th>Runs</th><th>p50</th><th>Cost</th></tr></thead>
        {stepGroups.map((g) => (
          <tbody>
            <tr class="group"><th colspan="6">{GROUP_TITLE[g] || g}</th></tr>
            {steps.filter((a) => a.name.split('.')[0] === g).map((a) => (
              <tr id={`step-${a.name}`}>
                <td><code>{a.name}</code></td><td>{a.kind}{a.cls && <span class="muted"> · {a.cls}</span>}</td>
                <td>{a.description}{a.tools?.length > 0 && <><br /><span class="note">Tools: {a.tools.map((t, i) => <>{i > 0 && ', '}<a href={`/docs/anis-tools#${t}`}>{t}</a></>)}</span></>}
                  {a.used_by?.length > 0 && <><br /><span class="note">In: {[...new Map(a.used_by.map((u) => [u.strategy, u])).values()].map((u, i) => <>{i > 0 && ', '}<a href={`#strategy-${u.strategy}`}>{label(u.name)}</a></>)}</span></>}</td>
                <td data-live={`a.${a.name}.runs`} data-fmt="n">{show(m, `a.${a.name}.runs`)}</td>
                <td data-live={`a.${a.name}.p50_ms`} data-fmt="ms">{show(m, `a.${a.name}.p50_ms`, 'ms')}</td>
                <td data-live={`a.${a.name}.usd`} data-fmt="usd">{show(m, `a.${a.name}.usd`, 'usd')}</td>
              </tr>
            ))}
          </tbody>
        ))}
      </table>
    </div>
  </section>

  {plan && (
    <section id="composition">
      <h2>Combining strategies</h2>
      {plan.composition.intro && <p>{plan.composition.intro}</p>}
      {plan.composition.rules.length > 0 && <p><strong>The rule for combining.</strong> Jev names the lead strategy and the others in one classification.</p>}
      {plan.composition.rules.length > 0 && <ul>{plan.composition.rules.map((r) => <li>{r}</li>)}</ul>}
      {plan.composition.sets.length > 0 && (
        <>
          <h3>Common combinations</h3>
          <div class="scroll">
            <table>
              <thead><tr><th>Set</th><th>Messages</th><th>How they combine</th></tr></thead>
              <tbody>{plan.composition.sets.map((s) => <tr><td><strong>{s.set}</strong>{s.example && <><br /><span class="note">{s.example}</span></>}</td><td>{s.count}</td><td>{s.how}</td></tr>)}</tbody>
            </table>
          </div>
          {plan.composition.note && <p class="note">{plan.composition.note}</p>}
        </>
      )}
      {(plan.composition.moves_note.length > 0 || plan.composition.other_moves.length > 0) && (
        <>
          <h3 id="moves">Follow-up moves</h3>
          {plan.composition.moves_note.map((n) => <p>{n}</p>)}
          {plan.composition.other_moves.length > 0 && (
            <div class="scroll">
              <table>
                <thead><tr><th>Move</th><th>Sounds like</th><th>Must do</th></tr></thead>
                <tbody>{plan.composition.other_moves.map((x) => <tr><td><strong>{x.move}</strong></td><td>{x.sounds_like}</td><td>{x.must_do}</td></tr>)}</tbody>
              </table>
            </div>
          )}
        </>
      )}
    </section>
  )}

  {plan?.decisions.length > 0 && (
    <section id="decisions">
      <h2>Decisions</h2>
      <ul class="decisions">{plan.decisions.map((d) => <li><span class="date">{d.date}</span> {d.text}</li>)}</ul>
    </section>
  )}
  {plan?.open_questions.length > 0 && (
    <section id="open-questions">
      <h2>Open questions</h2>
      <ul>{plan.open_questions.map((q) => <li>{typeof q === 'string' ? q : (q.text ?? q.q ?? JSON.stringify(q))}</li>)}</ul>
    </section>
  )}

  {plan && <p class="note source">Every entry, built or planned, is read from the strategy database{plan.source.updated && ` (plan updated ${plan.source.updated})`}. Building steps: the code.</p>}

  <script>
    import { bindLive, strategiesFlat } from '../../lib/anis-docs.js';
    bindLive(document.getElementById('strategies')?.parentElement, '/api/v1/anis/strategies', strategiesFlat);
    // #<id>, #strategy-<id>, #class-<id> or #<name> opens that accordion item and scrolls to it
    const openHash = () => {
      const h = decodeURIComponent(location.hash.slice(1));
      if (!h) return;
      const el = document.getElementById(h);
      const d = (el && el.closest('details')) || document.getElementById(`strategy-${h}`) || document.querySelector(`details[data-name="${CSS.escape(h.toLowerCase())}"]`);
      if (!d || d.tagName !== 'DETAILS') return;
      d.open = true;
      d.scrollIntoView();
    };
    openHash();
    addEventListener('hashchange', openHash);
  </script>
</DocsLayout>

<style>
  h3 { margin: 1.6rem 0 0.2rem; font-size: 1rem; }
  h4 { margin: 1.1rem 0 0.2rem; font-size: 0.92rem; }
  h2 { margin-top: 2.4rem; margin-bottom: 0.3rem; }
  .flow { width: 100%; max-width: 760px; height: auto; margin: 1.2rem 0 0.4rem; font-size: 12px; }
  .flow rect { stroke-width: 1; }
  .flow path { stroke-width: 1.5; }
  .numbers { display: flex; flex-wrap: wrap; gap: 0.6rem 1.8rem; margin-top: 1rem; }
  .numbers strong { display: inline-block; min-width: 2.2ch; text-align: right; }
  .note { font-size: 0.92rem; }
  .scroll { overflow-x: auto; }
  .nowrap { white-space: nowrap; }
  .muted { opacity: 0.7; }
  .chip { font-size: 0.7rem; text-transform: uppercase; letter-spacing: 0.04em; white-space: nowrap; border: 1px solid var(--border-default); border-radius: 4px; padding: 0 0.35rem; }
  .chip.g-strong { color: var(--success); }
  .chip.g-moderate { color: var(--info); }
  .chip.g-few { color: var(--warning); }
  .chip.g-thin { color: var(--error); }
  .chip.st-built { color: var(--success); }
  .chip.st-planned { color: var(--text-muted); }
  .chip.st-shared { color: var(--info); }
  .chip.st-unmatched { color: var(--warning); }
  .steps td { vertical-align: top; font-size: 0.9rem; }
  .steps tr.group th { text-align: left; padding-top: 1rem; }
  .steps td:nth-child(n+4) { min-width: 6ch; white-space: nowrap; }
  .decisions .date { font-weight: 600; white-space: nowrap; margin-right: 0.4rem; }
  .source { margin-top: 2.4rem; }

  /* the strategy accordion */
  .cards { display: flex; flex-direction: column; gap: 0.45rem; margin-top: 0.6rem; }
  .cards .group { margin: 1.5rem 0 0; font-size: 0.78rem; letter-spacing: 0.06em; text-transform: uppercase; color: var(--text-muted); }
  .card { border: 1px solid var(--border-default); border-radius: 10px; background: var(--surface-1); min-width: 0; }
  .card > summary { position: relative; cursor: pointer; list-style: none; display: flex; align-items: center; gap: 0.7rem; padding: 0.7rem 1rem; white-space: nowrap; border-radius: 10px; }
  .card > summary::-webkit-details-marker { display: none; }
  .card > summary:focus-visible, .notes > summary:focus-visible { outline: 2px solid var(--accent-primary); outline-offset: 2px; }
  .card > summary:hover { background: var(--surface-2); }
  .anchor { position: absolute; }
  .chev { flex: none; width: 0.5rem; height: 0.5rem; border-right: 2px solid var(--text-muted); border-bottom: 2px solid var(--text-muted); transform: rotate(-45deg); transition: transform 0.15s; margin-right: 0.1rem; }
  .card[open] > summary > .chev { transform: rotate(45deg); }
  .title { flex: 0 1 auto; min-width: 0; overflow: hidden; text-overflow: ellipsis; font-weight: 600; }
  .tagline { flex: 1 1 0; min-width: 0; overflow: hidden; text-overflow: ellipsis; color: var(--text-secondary); font-size: 0.92rem; }
  .tagline.quote { font-style: italic; }
  .card > summary .chip { flex: none; min-width: 7.2rem; text-align: center; }
  .keys { flex: none; font-size: 0.85rem; color: var(--text-secondary); min-width: 17ch; text-align: right; }
  .keys strong { font-weight: 600; }
  .card .body { padding: 0 1.2rem 1.2rem; border-top: 1px solid var(--border-subtle); min-width: 0; }
  .body h3.first { margin-top: 1.1rem; }
  .jevcard { border: 1px solid var(--border-default); border-left: 4px solid var(--accent-primary); border-radius: 8px; background: var(--surface-2); padding: 0.7rem 1rem; margin: 0.4rem 0; }
  .jevcard p { margin: 0.35rem 0; }
  .jevcard code { font-weight: 600; margin-right: 0.3rem; }
  .jevcard .foot { font-size: 0.85rem; color: var(--text-muted); }
  .pattern + .pattern { border-top: 1px solid var(--border-subtle); margin-top: 0.9rem; padding-top: 0.2rem; }
  .plead { margin: 0.6rem 0 0.25rem; }
  .chips { display: flex; flex-wrap: wrap; gap: 0.35rem; margin: 0.2rem 0 0.5rem; }
  .qchip { border: 1px solid var(--border-default); border-radius: 999px; padding: 0.1rem 0.7rem; font-size: 0.88rem; background: var(--surface-0); }
  .quotes, .misses { font-size: 0.92rem; }
  .callout { border-left: 4px solid var(--success); background: var(--surface-2); border-radius: 0 8px 8px 0; padding: 0.6rem 1rem; margin: 0.4rem 0 0.7rem; }
  .calloutlabel { display: block; font-size: 0.72rem; letter-spacing: 0.06em; text-transform: uppercase; color: var(--text-muted); margin-bottom: 0.2rem; }
  .route { padding-left: 1.5rem; list-style: decimal; }
  .route li { margin: 0.2rem 0; }
  .jevchip { color: var(--accent-primary); margin-right: 0.2rem; }
  .facts { display: flex; flex-wrap: wrap; gap: 0.3rem 1.6rem; font-size: 0.9rem; margin: 0.5rem 0 0; }
  .facts b { font-weight: 600; margin-right: 0.3rem; }
  .modes { display: grid; grid-template-columns: repeat(3, minmax(0, 1fr)); gap: 0.8rem; margin: 0.5rem 0; }
  .mode { border: 1px solid var(--border-default); border-radius: 8px; padding: 0.6rem 0.9rem; background: var(--surface-0); }
  .mode .modehead { margin: 0 0 0.3rem; display: flex; gap: 0.5rem; align-items: center; }
  .mode ul { margin: 0; padding-left: 1.1rem; font-size: 0.9rem; }
  .tree { list-style: none; padding: 0; margin: 0.4rem 0; display: grid; gap: 0.35rem; }
  .tree li { display: grid; grid-template-columns: 2rem minmax(0, 1fr); column-gap: 0.4rem; align-items: baseline; padding: 0.3rem 0.6rem; border: 1px solid var(--border-subtle); border-radius: 6px; scroll-margin-top: 5rem; }
  .tree .num { grid-row: span 2; font-weight: 600; color: var(--text-muted); text-align: right; padding-right: 0.3rem; }
  .tree .stepname { font-weight: 600; }
  .tree .exits { font-size: 0.85rem; color: var(--text-secondary); }
  .chip.kind-Jev { color: var(--accent-primary); }
  .chip.kind-LLM { color: var(--warning); }
  .chip.kind-tool { color: var(--info); }
  .tiles { display: grid; grid-template-columns: repeat(4, minmax(0, 1fr)); gap: 0.6rem; margin: 0.5rem 0; }
  .tile { border: 1px solid var(--border-default); border-radius: 8px; padding: 0.5rem 0.8rem; background: var(--surface-0); display: flex; flex-direction: column; min-height: 4rem; }
  .tile .tl { font-size: 0.78rem; color: var(--text-muted); }
  .tile strong { font-size: 1.15rem; font-variant-numeric: tabular-nums; }
  .path { font-size: 0.82rem; }
  .notes { margin-top: 1.4rem; border-top: 1px solid var(--border-subtle); padding-top: 0.6rem; }
  .notes > summary { cursor: pointer; font-weight: 600; font-size: 0.92rem; color: var(--text-secondary); }
  .tiers th { text-align: left; white-space: nowrap; vertical-align: top; padding-right: 0.8rem; font-weight: 600; font-size: 0.88rem; }
  .tiers td { font-size: 0.9rem; }
  .body dl { display: grid; grid-template-columns: max-content 1fr; gap: 0.15rem 0.9rem; margin: 0.4rem 0; font-size: 0.92rem; }
  .body dt { font-weight: 600; }
  .body dd { margin: 0; min-width: 0; }
  @media (max-width: 900px) { .keys { display: none; } .modes { grid-template-columns: 1fr; } }
  @media (max-width: 640px) {
    .tiles { grid-template-columns: repeat(2, minmax(0, 1fr)); }
    .tagline { display: none; }
    .card > summary { padding: 0.7rem 0.8rem; }
    .card .body { padding: 0 0.8rem 1rem; }
    .body dl { grid-template-columns: 1fr; }
    .tiers th { white-space: normal; }
  }
</style>
