---
// The biographical archive (/biography; on anis.oceanlibrary.com /bio). SSR, edge-cached (worker/edge-cache.js): the cast
// data is in the first view, so the page paints full cards at once and the search/filter island hydrates onto it
// (client:idle). Built on the public API (/api/v1/people …), the same endpoints any third-party consumer uses.
// No data → 503 (never an empty shell that fills in client-side; the edge keeps serving its last good copy).

import Layout from '../layouts/Layout.astro';
import SiteNav from '../components/anis/SiteNav.astro';
import BiographyBrowser from '../components/BiographyBrowser.svelte';

const API = import.meta.env.PUBLIC_API_URL || 'https://api.siftersearch.com';
// the full cast (~600 people, ~440KB) is a heavy query: one patient retry, then 503
let initialData = null;
for (let attempt = 0; attempt < 2 && !initialData?.people?.length; attempt++) {
  if (attempt > 0) await new Promise((r) => setTimeout(r, 1500));
  try {
    const res = await fetch(`${API}/api/v1/people?limit=2000`, { signal: AbortSignal.timeout(30000) });
    if (res.ok) initialData = await res.json();
  } catch { /* transient — retry */ }
}
if (!initialData?.people?.length) return new Response('The biographical archive is briefly unavailable. Please try again in a moment.', { status: 503, headers: { 'Retry-After': '60', 'Cache-Control': 'no-store' } });
Astro.response.headers.set('Cache-Control', 'public, max-age=300, s-maxage=900, stale-while-revalidate=3600');
---

<Layout
  title="Biographical Archive — SifterSearch"
  description="A searchable archive of the people of early Bábí and Bahá'í history — kings and martyrs, scholars and villagers — with portraits, relationships, and sources drawn from across the library."
>
  <SiteNav currentPage="biography" />
  <BiographyBrowser client:idle initialData={initialData} />
</Layout>
