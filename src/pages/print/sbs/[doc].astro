---
// Printable side-by-side document. SSR fetches page 1 from the absolute API origin; the island loads the rest.
import PrintLayout from '../../../layouts/PrintLayout.astro';
import SbsDocument from '../../../components/print/SbsDocument.svelte';
import { sbsUrl, pageUrlFor } from '../../../lib/sbs.js';
const API = import.meta.env.PUBLIC_API_URL || 'https://api.siftersearch.com';
const id = Astro.params.doc;
let first = null, status = 200;
try { const r = await fetch(sbsUrl(API, id, 0, 400), { signal: AbortSignal.timeout(8000) }); status = r.status; if (r.ok) first = await r.json(); } catch { status = 0; }
if (status === 403 || status === 404) Astro.response.status = status;
const title = first?.doc?.title ? `${first.doc.title} (side by side) - SifterSearch` : 'Side-by-side document - SifterSearch';
const pageUrl = pageUrlFor(Astro.url.origin, id);
---
<PrintLayout title={title} description="Original and English side by side, sentence by sentence">
  <link slot="head" rel="preconnect" href="https://fonts.googleapis.com" />
  <link slot="head" href="https://fonts.googleapis.com/css2?family=Scheherazade+New:wght@400;700&family=Source+Serif+4:ital,opsz,wght@0,8..60,400;0,8..60,600;1,8..60,400&family=EB+Garamond:wght@400;500&display=swap" rel="stylesheet" />
  <SbsDocument client:load docId={id} initial={first} initialStatus={status} pageUrl={pageUrl} apiBase={import.meta.env.PUBLIC_API_URL || ''} />
</PrintLayout>
