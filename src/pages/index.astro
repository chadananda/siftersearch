---
import Layout from '../layouts/Layout.astro';
import IslandSkeleton from '../components/common/IslandSkeleton.astro';
import LiquidBackground from '../components/LiquidBackground.svelte';
import ChatInterface from '../components/ChatInterface.svelte';
---

<Layout title="SifterSearch - AI-Powered Interfaith Library" description="Search thousands of sacred texts from world religions with AI-powered semantic search. Explore Baha'i writings, pilgrim notes, and interfaith literature instantly.">
  <LiquidBackground client:only="svelte" />
  <main class="main-container">
    <!-- Navbar + library summary as before; the chat itself is Anís (below), as on any host site. -->
    <ChatInterface client:only="svelte" showInput={false}><IslandSkeleton slot="fallback" /></ChatInterface>
  </main>
  <!-- Anís — the same one-line embed every host site uses (backlog 0015). -->
  <script is:inline src="https://siftersearch.com/widget.js" data-key="wgt_house_siftersearch" data-name="Anís" async></script>
</Layout>

<style>
  .main-container {
    min-height: 100vh;
    min-height: 100dvh;
    position: relative;
  }
</style>
