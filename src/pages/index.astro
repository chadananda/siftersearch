---
// Home page = the Observatory (Chad 10-16): a live dashboard of the library being indexed and studied, in public.
// Keeps the site chrome — navbar, the liquid background, Anís's chat button (from Layout) and the footer.
import Layout from '../layouts/Layout.astro';
import LiquidBackground from '../components/LiquidBackground.svelte';
import NavBar from '../components/common/NavBar.svelte';
import Observatory from '../components/observatory/Observatory.svelte';
---

<Layout title="SifterSearch — An interfaith library, learning in public" description="A live observatory of an interfaith library of sacred texts: every passage of eleven traditions searched, questioned and studied by machine, in the open.">
  <LiquidBackground client:only="svelte" />
  <NavBar client:load currentPage="home" />
  <main class="main-container">
    <Observatory client:only="svelte" />
  </main>
</Layout>

<style>
  .main-container { min-height: 100vh; min-height: 100dvh; position: relative; }
</style>
