---
// /media/<slug> — one talk, in the Listening Room language (planning/media-listing-design.md): broadcast card + player,
// typeset transcript, program log, related talks. SSR fetches GET /api/media/:slug (404 when missing) and the listing
// index (related talks, speaker key; optional) at request time, so the whole transcript paints before hydration.
// ?t=754 / ?t=754-812 is read here (the #t= fragment only on the client). Canonical is /media/<slug>.
import Layout from '../../layouts/Layout.astro';
import NavBar from '../../components/common/NavBar.svelte';
import MediaPlayer from '../../components/media/MediaPlayer.svelte';
import TalkHero from '../../components/media/TalkHero.svelte';
import { eraVar } from '../../lib/media-listing.js';
import { parseRange } from '../../../api/lib/media/range.js';
import { ikUrl } from '../../lib/imagekit.js';
import { relatedTalks, safeIndex } from '../../lib/media-listing.js';

export const prerender = false;

const API_BASE = import.meta.env.PUBLIC_API_URL || 'https://api.siftersearch.com'; // SSR fetch — needs absolute origin
const { slug } = Astro.params;
// the old moment link form /media/<slug>?m=<key> → the canonical moment page
const mKey = Astro.url.searchParams.get('m');
if (slug && mKey && /^[\w-]{4,16}$/.test(mKey)) return Astro.redirect(`/media/${encodeURIComponent(slug)}/m/${encodeURIComponent(mKey)}`, 301);

let item = null;
let fetchError = null;
let index = null;
const getIndex = fetch(`${API_BASE}/api/media/index`, { signal: AbortSignal.timeout(6000) }).then((r) => (r.ok ? r.json() : null)).catch(() => null);
try {
  const res = await fetch(`${API_BASE}/api/media/${encodeURIComponent(slug || '')}`, { signal: AbortSignal.timeout(15000) });
  if (res.ok) item = await res.json();
  else if (res.status !== 404) fetchError = `API returned ${res.status}`;
} catch (err) {
  fetchError = err instanceof Error ? err.message : String(err);
  console.error('media item fetch failed', { slug, err: fetchError });
}

if (fetchError) return new Response(`Bad gateway: ${fetchError}`, { status: 502 });
if (!item) Astro.response.status = 404;
Astro.response.headers.set('Cache-Control', item ? 'public, s-maxage=120, stale-while-revalidate=300' : 'public, s-maxage=60');

if (item) index = await getIndex;
if (index) index = safeIndex(index);
const me = index?.items?.find((x) => x.s === item?.slug);
const related = item && index ? relatedTalks(index.items, item.slug, 6) : [];
const speakersByKey = Object.fromEntries((index?.speakers || []).filter((s) => related.some((r) => r.k === s.k)).map((s) => [s.k, { n: s.n, p: s.p }]));

const initialRange = parseRange(Astro.url.searchParams.get('t'));
const who = item ? [item.speaker, item.year].filter(Boolean).join(', ') : '';
const title = item ? `${item.title}${who ? ` — ${who}` : ''} — SifterSearch Media` : 'Recording not found — SifterSearch Media';
const description = item ? (item.summary || `${item.title}${item.speaker ? ` by ${item.speaker}` : ''}: a talk with a word-aligned, searchable transcript.`).slice(0, 300) : 'This recording could not be found.';
// og:image must be raster and sized for cards: the portrait through the image worker, 1200×630, face-centred
// og:image: the talk's best moment as a quote card (1200×630 by design) when it has one; else the portrait cropped
// face-centred (cover — never stretched)
const bestMoment = (item?.moments || []).slice().sort((x, y) => (x.rank ?? 9) - (y.rank ?? 9))[0];
const image = bestMoment ? `https://siftersearch.com/api/media/moments/${encodeURIComponent(bestMoment.key)}/card.jpg?v=2`
  : item?.thumb?.kind === 'photo' ? ikUrl(item.thumb.url, 'w-1200,h-630,fo-face,q-80')
  : item?.thumb?.url && !/\.svg(\?|$)/.test(item.thumb.url) ? item.thumb.url : undefined;
const url = item ? `https://siftersearch.com/media/${item.slug}` : null;
const iso = (s) => { s = Math.round(s || 0); return `PT${Math.floor(s / 3600) ? `${Math.floor(s / 3600)}H` : ''}${Math.floor((s % 3600) / 60)}M${s % 60}S`; };
const transcriptText = item ? item.paragraphs.map((p) => p.words.filter((w) => !w[3]).map((w) => w[0]).join(' ')).join('\n\n') : '';
const ld = item ? [{
  '@context': 'https://schema.org', '@type': 'AudioObject', name: item.title, url, description,
  ...(item.speaker ? { author: { '@type': 'Person', name: item.speaker } } : {}),
  ...(item.date || item.year ? { dateCreated: String(item.date || item.year) } : {}),
  ...(item.duration_s ? { duration: iso(item.duration_s) } : {}), inLanguage: item.language || 'en', encodingFormat: 'audio/ogg',
  ...(item.audio?.m4a ? { contentUrl: `https://siftersearch.com${item.audio.m4a}` } : {}),
  ...(image ? { thumbnailUrl: image } : {}), ...(item.topics?.length ? { keywords: item.topics.join(', ') } : {}),
  transcript: transcriptText.slice(0, 20000),
  isPartOf: { '@type': 'Collection', name: 'The Listening Room — SifterSearch Media', url: 'https://siftersearch.com/media' },
}, {
  '@context': 'https://schema.org', '@type': 'BreadcrumbList', itemListElement: [
    { '@type': 'ListItem', position: 1, name: 'The Listening Room', item: 'https://siftersearch.com/media' },
    { '@type': 'ListItem', position: 2, name: item.title, item: url },
  ],
}] : [];
---

<Layout {title} {description} {image} type={item ? 'article' : 'website'} noindex={!item}>
  <Fragment slot="head">
    <link rel="preload" as="font" type="font/woff2" href="/fonts/gloock-latin.woff2" crossorigin />
    <link rel="preload" as="font" type="font/woff2" href="/fonts/big-shoulders-latin.woff2" crossorigin />
    <link rel="preload" as="font" type="font/woff2" href="/fonts/libre-caslon-normal-400-latin.woff2" crossorigin />
    {ld.map((x) => <script type="application/ld+json" set:html={JSON.stringify(x)} />)}
  </Fragment>
  <NavBar client:idle currentPage="media" />
  <main class="listening-room bg-radio-room text-radio-ink">
    <div class="mx-auto w-full max-w-6xl px-4 pb-28 pt-4 sm:px-6 lg:px-8 lg:pt-8">
      {item ? (
        <div style={`--tint:${eraVar(item.year)}`}>
          <TalkHero {item} speakerKey={me?.k || null} />
          <MediaPlayer client:load {item} {initialRange} {related} speakerKey={me?.k || null} {speakersByKey} />
        </div>
      ) : (
        <section class="py-24 text-center">
          <p class="font-dial text-7xl font-extrabold text-radio-amber">404</p>
          <h1 class="mt-4 font-marquee text-3xl text-radio-ink">Nothing on this frequency</h1>
          <p class="mt-3 text-radio-ink-soft">There is no published recording at this address.</p>
          <a href="/media" class="mt-6 inline-block rounded-full bg-radio-amber px-6 py-3 font-dial text-lg font-bold uppercase tracking-wider text-radio-walnut-deep">Back to the Listening Room</a>
        </section>
      )}
    </div>
  </main>
</Layout>
