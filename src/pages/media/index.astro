---
// /media — the talks library: filtered listing + search across every transcript. SSR fetches the first page (and facets)
// at request time so the page paints full content; the MediaBrowser island then owns filtering (URL params mirror it).
import Layout from '../../layouts/Layout.astro';
import NavBar from '../../components/common/NavBar.svelte';
import MediaBrowser from '../../components/media/MediaBrowser.svelte';
import { filtersFromParams, apiQuery } from '../../lib/media.js';

export const prerender = false;

const API_BASE = import.meta.env.PUBLIC_API_URL || 'https://api.siftersearch.com'; // SSR fetch — needs absolute origin
const filters = filtersFromParams(Astro.url.searchParams);

let initialData = null;
let fetchError = null;
try {
  const res = await fetch(`${API_BASE}/api/media?${apiQuery(filters)}`, { signal: AbortSignal.timeout(15000) });
  if (res.ok) initialData = await res.json();
  else fetchError = `API returned ${res.status}`;
} catch (err) {
  fetchError = err instanceof Error ? err.message : String(err);
  console.error('media index fetch failed', fetchError);
}

Astro.response.headers.set('Cache-Control', 'public, s-maxage=120, stale-while-revalidate=3600');
const hours = initialData?.facets?.hours;
const description = `Talks and recorded classes with aligned, searchable transcripts${hours ? ` — ${hours} hours` : ''}. Click any word to hear it; quotations are linked to their sources.`;
---

<Layout title="Media — talks with searchable transcripts — SifterSearch" description={description}>
  <NavBar client:idle currentPage="media" />
  <main class="mx-auto w-full max-w-7xl px-4 py-6 sm:px-6 lg:px-8 lg:py-10">
    <MediaBrowser client:load {initialData} initialFilters={filters} {fetchError} />
  </main>
</Layout>
