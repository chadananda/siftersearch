---
// Dewey, the AI Librarian — for admins and members granted access on /admin/users (users.dewey_access).
import Layout from '../layouts/Layout.astro';
import IslandSkeleton from '../components/common/IslandSkeleton.astro';
import NavBar from '../components/common/NavBar.svelte';
import DeweyHome from '../components/dewey/DeweyHome.svelte';
---

<Layout title="Dewey - SifterSearch" description="Dewey, the AI Librarian for Ocean 2.0.">
  <NavBar currentPage="dewey" client:load />
  <main class="dewey-wrapper">
    <div class="page-container">
      <DeweyHome client:only="svelte"><IslandSkeleton slot="fallback" /></DeweyHome>
    </div>
  </main>
</Layout>

<style>
  /* Dewey mode (Chad 10-17): the library on the left, Dewey's chat in the middle, added books on the right; the chat
     alone, full screen, on a phone */
  .dewey-wrapper { height: calc(100dvh - 3.5rem); }
  .page-container { height: 100%; max-width: 1680px; margin: 0 auto; padding: 0.75rem 1rem; }
</style>
