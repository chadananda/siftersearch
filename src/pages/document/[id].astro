---
// /document/{id} → the document's public home (Chad 11-14): a collaborator's page when one holds it, else its Anís /doc page
// (api/lib/library/doc-home.js). Exists so that Jafar citation links (siftersearch.com/document/{id}) resolve.
import { docHome } from '../../../api/lib/library/doc-home.js';
const { id } = Astro.params;
const docId = parseInt(id, 10);

const API_BASE = import.meta.env.PUBLIC_API_URL || 'https://api.siftersearch.com';
let redirectUrl = '/library/';

if (docId > 0) {
  redirectUrl = `https://anis.oceanlibrary.com/doc/${docId}`;   // the bare id resolves (and 301s) there
  try {
    const res = await fetch(`${API_BASE}/api/library/documents/${docId}?includeParagraphs=false`, { signal: AbortSignal.timeout(3000) });
    if (res.ok) {
      const doc = (await res.json())?.document;
      if (doc?.title) redirectUrl = docHome({ ...doc, id: docId }) || redirectUrl;
    }
  } catch { /* the bare id still resolves */ }
}

return Astro.redirect(redirectUrl, 301);
---
