---
// Server-rendered series links work before hydration and without JavaScript.
const { series, slug, compact = false } = Astro.props;
---
{series && <nav aria-label={`${series.name} series navigation`} class="my-6 rounded-2xl border border-radio-line bg-radio-panel p-4 sm:p-5">
  <p class="font-dial text-xs font-bold uppercase tracking-wider text-radio-ink-soft">In this series · recording {series.position + 1} of {series.items.length}</p>
  <a href={series.href} class="mt-1 block font-marquee text-xl text-radio-ink underline decoration-radio-brass underline-offset-4 hover:text-radio-amber">{series.name}</a>
  <div class="mt-4 grid gap-3 sm:grid-cols-2">
    {series.previous ? <a href={`/media/${series.previous.s}`} rel="prev" class="rounded-lg border border-radio-line p-3 text-radio-ink hover:bg-radio-paper">
      <span class="block font-dial text-xs font-bold uppercase tracking-wider text-radio-ink-soft">← Previous talk{series.previous.part ? ` · part ${series.previous.part}` : ''}</span>
      <span class="mt-1 block text-sm">{series.previous.t}</span>
    </a> : <p class="p-3 text-sm text-radio-ink-soft">First available recording in this set</p>}
    {series.next ? <a href={`/media/${series.next.s}`} rel="next" class="rounded-lg border border-radio-line p-3 text-radio-ink hover:bg-radio-paper">
      <span class="block font-dial text-xs font-bold uppercase tracking-wider text-radio-ink-soft">Next talk →{series.next.part ? ` · part ${series.next.part}` : ''}</span>
      <span class="mt-1 block text-sm">{series.next.t}</span>
    </a> : <p class="p-3 text-sm text-radio-ink-soft">Last available recording in this set</p>}
  </div>
  {!compact && <details class="mt-4">
    <summary class="cursor-pointer font-semibold text-radio-ink underline decoration-radio-brass underline-offset-4">Browse all {series.items.length} talks in this set</summary>
    <ol class="mt-3 max-h-72 space-y-1 overflow-y-auto overscroll-contain pr-2">
      {series.items.map((talk) => <li>
        <a href={`/media/${talk.s}`} aria-current={talk.s === slug ? 'page' : undefined} class:list={['block rounded-lg px-3 py-2 text-sm text-radio-ink hover:bg-radio-paper',talk.s === slug && 'bg-radio-paper font-bold']}>
          {talk.part ? `${talk.part}. ` : ''}{talk.t}{talk.s === slug ? ' · You are here' : ''}
        </a>
      </li>)}
    </ol>
  </details>}
</nav>}
