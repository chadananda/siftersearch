---
// Global footer (Chad 10-10): the toolbar keeps the core destinations; Research, Docs, About, Contact and the legal pages
// live here on every public page (rendered by layouts/Layout.astro).
const year = new Date().getFullYear();
const groups = [
  ['Explore', [['Research', '/research'], ['Library', '/library'], ['Dialogue', '/dialogue'], ['Biography', '/biography'], ['SourceHunt', '/sourcehunt']]],
  ['About', [['About SifterSearch', '/about'], ['Anís', '/docs/agents/anis'], ['Docs', '/docs'], ['API', '/docs/api'], ['Changelog', '/changelog']]],
  ['Help', [['Contact', '/contact'], ['Support the project', '/support'], ['Terms of Service', '/terms'], ['Privacy', '/privacy']]],
];
---

<footer class="site-footer border-t border-border-subtle bg-surface-0/80 text-secondary">
  <div class="mx-auto max-w-6xl px-4 py-10 grid gap-8 sm:grid-cols-2 lg:grid-cols-4">
    <div class="flex flex-col gap-2">
      <a href="/" class="text-primary font-semibold">SifterSearch</a>
      <p class="text-sm">An interfaith library you can ask. A companion to
        <a href="https://oceanlibrary.com" class="text-accent hover:text-accent-hover">OceanLibrary.com</a>.</p>
    </div>
    {groups.map(([title, links]) => (
      <nav aria-label={title} class="flex flex-col gap-2 text-sm">
        <h2 class="text-xs uppercase tracking-wider text-muted">{title}</h2>
        {links.map(([label, href]) => <a href={href} class="hover:text-primary">{label}</a>)}
      </nav>
    ))}
  </div>
  <p class="mx-auto max-w-6xl px-4 pb-8 text-xs text-muted">&copy; {year} Chad Jones.</p>
</footer>
