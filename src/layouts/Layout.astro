---
import { SEO } from 'astro-seo';
import SiteFooter from '../components/common/SiteFooter.astro';
import AnisWidget from '../components/AnisWidget.astro';
import { isAnisHost, anisPath, anisTitle, ANIS_ORIGIN } from '../lib/anis-host.js';
import { THEME_PREP } from '../../worker/anis/content-widget.js';

interface Props {
  title: string;
  description?: string;
  image?: string;
  type?: string;
  noindex?: boolean;
  footer?: boolean;   // the global footer (off for full-height app views)
  anis?: boolean;     // Anís's chat button — on every public page (Chad 10-10)
  app?: { manifest: string; icon: string; name: string; color: string };   // an installable app on its own (Dewey: /dewey/manifest.webmanifest)
  canonical?: string; // the page's ONE canonical URL (absolute or site path). Pages never emit their own <link rel="canonical">.
  anisPage?: { type: string; slug?: string; title: string };   // on anis.oceanlibrary.com: the widget's page context
}

const siteUrl = 'https://siftersearch.com';
// rendered on anis.oceanlibrary.com (worker/index.js → src/lib/anis-host.js): Anís chrome, the reader's theme, Anís canonical
const anisHost = isAnisHost(Astro.url);
const siteName = anisHost ? 'Ocean 2.0' : 'SifterSearch';

const {
  title: pageTitle,
  description: pageDescription = 'Search thousands of sacred texts from world religions with AI-powered semantic search. Explore Baha\'i writings, pilgrim notes, and interfaith literature instantly.',
  // /og-image.png has never existed in public/, so every page that did not pass an
  // explicit hero shipped an og:image that 404s — no preview card on any share.
  // icon-512 is a stopgap that at least resolves; a real 1200x630 card is wanted.
  image = null,
  type = 'website',
  noindex = false,
  footer = true,
  anis = true,
  app = null,
  canonical = null,
  anisPage = null
} = Astro.props;
const title = anisHost ? anisTitle(pageTitle) : pageTitle;
const description = anisHost ? anisTitle(pageDescription) : pageDescription;

// The ONE canonical (+ og:url): the page's explicit canonical, else the current path. Trailing slash dropped (except
// the root) so /a/b/ and /a/b name one URL — the sitemap lists them without it. tests/frontend/canonical-single.test.js
const canonicalUrl = (() => {
  const u = new URL(canonical || Astro.url.pathname, siteUrl);
  u.search = ''; u.hash = '';
  if (u.pathname.length > 1) u.pathname = u.pathname.replace(/\/+$/, '');
  // on the Anís host every page is canonical there (/biography → /bio, /dialogue → /discuss): its links and URLs all stay on it
  if (anisHost) return ANIS_ORIGIN + anisPath(u.pathname);
  return u.href;
})();
const imageUrl = anisHost ? new URL(image || '/anis-app/og-1200x630.png', ANIS_ORIGIN).href : new URL(image || '/icon-512.png', siteUrl).href;

// Structured data for the website (SearchAction for sitelinks searchbox)
const websiteSchema = {
  "@context": "https://schema.org",
  "@type": "WebSite",
  "name": siteName,
  "alternateName": "Ocean 2.0 Interfaith Library",
  "url": siteUrl,
  "description": description,
  "potentialAction": {
    "@type": "SearchAction",
    "target": {
      "@type": "EntryPoint",
      "urlTemplate": `${siteUrl}/?q={search_term_string}`
    },
    "query-input": "required name=search_term_string"
  }
};

// Organization schema
const organizationSchema = {
  "@context": "https://schema.org",
  "@type": "Organization",
  "name": siteName,
  "url": siteUrl,
  "logo": `${siteUrl}/logo.svg`,
  "description": "AI-powered interfaith library search system"
};
---

<!doctype html>
<html lang="en" data-theme={anisHost ? undefined : 'dark'} style={anisHost ? undefined : 'background:#0a162a;color:#e6edf6;'}>
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="theme-color" content="#0a162a" />
    <!-- Inline critical bg color so first paint is dark — prevents white flash on refresh. body is a full-height column so
         the footer (margin-top:auto) sits at the bottom of short pages (Chad 10-10).
         body must be transparent so the LiquidBackground canvas (z-index:-10) shows through. -->
    <style>html{background:#0a162a;color:#e6edf6;}body{background:transparent;color:#e6edf6;margin:0;min-height:100vh;min-height:100dvh;display:flex;flex-direction:column;}</style>
    <!-- Anís host: light or dark from the system, then the reader's stored choice (THEME_PREP), before first paint -->
    {anisHost && <Fragment set:html={THEME_PREP + '<style>html:root{background:light-dark(#fff,#0a162a);color:light-dark(#0f172a,#e6edf6)}html:root body{color:inherit}</style>'} />}

    <!-- SEO Component handles: title, description, canonical, OG, Twitter -->
    <SEO
      title={title}
      description={description}
      canonical={canonicalUrl}
      noindex={noindex}
      nofollow={noindex}
      openGraph={{
        basic: {
          title: title,
          type: type,
          image: imageUrl,
          url: canonicalUrl,
        },
        optional: {
          description: description,
          siteName: siteName,
          locale: "en_US",
        },
        image: {
          url: imageUrl,
          alt: `${title} - ${siteName}`,
          width: 1200,
          height: 630,
        },
      }}
      twitter={{
        card: "summary_large_image",
        site: anisHost ? undefined : "@siftersearch",
        title: title,
        description: description,
        image: imageUrl,
        imageAlt: `${title} - ${siteName}`,
      }}
    />

    <!-- Structured Data (JSON-LD) -->
    {!anisHost && <script type="application/ld+json" set:html={JSON.stringify(websiteSchema)} />}
    {!anisHost && <script type="application/ld+json" set:html={JSON.stringify(organizationSchema)} />}

    {anisHost ? <link rel="icon" type="image/png" sizes="32x32" href="/anis-app/favicon-32.png" /> : <link rel="icon" type="image/svg+xml" href="/ocean.svg" />}
    <link rel="apple-touch-icon" href={anisHost ? '/anis-app/apple-touch-icon.png' : app?.icon || '/apple-touch-icon.png'} />
    <link rel="manifest" href={anisHost ? '/anis.webmanifest' : app?.manifest || '/manifest.webmanifest'} />
    {app && <meta name="mobile-web-app-capable" content="yes" />}
    {app && <meta name="apple-mobile-web-app-capable" content="yes" />}
    {app && <meta name="apple-mobile-web-app-title" content={app.name} />}
    {app && <meta name="theme-color" content={app.color} />}

    <!-- Fonts never block the first paint (Chad 10-22). Libre Caslon Text (English content) is self-hosted in
         /fonts with metric-matched fallbacks (global.css; reading pages preload it). Amiri (Arabic/Persian) still
         comes from Google Fonts, loaded as a non-blocking stylesheet (print → all swap) — only those scripts use it. -->
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Amiri:ital,wght@0,400;0,700;1,400;1,700&display=swap" media="print" onload="this.media='all'" />
    <noscript><link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Amiri:ital,wght@0,400;0,700;1,400;1,700&display=swap" /></noscript>

    <!-- Additional head content slot (for page-specific meta tags, structured data) -->
    <slot name="head" />
  </head>
  <body>
    <slot />
    {footer && !anisHost && <SiteFooter />}
    {anis && !anisHost && <script is:inline src="https://siftersearch.com/widget.js" data-key="wgt_house_siftersearch" data-name="Anís" async></script>}
    {anisHost && <AnisWidget {...(anisPage || { type: 'page', title })} />}
    <script>
    import { startHoverPrefetch } from '../lib/hover-prefetch.js';
    startHoverPrefetch();
  </script>
</body>
</html>

<style is:global>
  @import '../styles/global.css';
</style>
