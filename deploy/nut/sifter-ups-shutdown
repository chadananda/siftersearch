#!/bin/sh
# /usr/local/bin/sifter-ups-shutdown — upsmon's SHUTDOWNCMD (runs as root) on LOW BATTERY only (OB + LB; ups.conf thresholds).
# Make sure the flush is done (a no-op when read-only mode already flushed), flush the RAM disk once more, power off.
# Ledger lines (services-stopped, poweroff with battery % + runtime + writer mode) are the report's evidence after boot.
logger -t sifter-ups-shutdown "LOW BATTERY: final flush, then clean shutdown"
if [ "${SIFTER_TEST:-0}" = 1 ]; then logger -t sifter-ups-shutdown "TEST would flush + shutdown -h +0"; exit 0; fi
P=/home/chad/sifter/siftersearch/scripts/ops/ups-power.sh
sudo -n -u chad $P enter --grace 5 || true
if systemctl start sifter-powerdown.target; then sudo -n -u chad $P ledger services-stopped ok "sifter-powerdown.target"
else sudo -n -u chad $P ledger services-stopped fail "sifter-powerdown.target failed"; fi
sudo -n -u chad $P ledger poweroff ok "shutdown -h +0"
exec /sbin/shutdown -h +0
