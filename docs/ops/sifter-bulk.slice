[Unit]
Description=Bulk media + indexing work: capped so it can never starve search and the site (Chad 10-24)
[Slice]
CPUAccounting=yes
MemoryAccounting=yes
CPUQuota=4000%   # 10-28: 2000% -> 4000% (nr_throttled was ~0; weights only protect vs user.slice siblings, system.slice (pm2 api) competes at the slice level, so a ceiling stays). Rollback: 2000%
CPUWeight=20
MemoryHigh=44G
MemoryMax=56G
TasksMax=4096
