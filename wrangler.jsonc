{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "siftersearch",
  // Custom entry wraps the Astro worker to proxy /api/* → tower-nas tunnel (see worker/index.js).
  "main": "worker/index.js",
  "compatibility_date": "2025-11-01",
  "compatibility_flags": ["nodejs_compat"],
  "assets": {
    "binding": "ASSETS",
    "directory": "./dist"
  },
  "workers_dev": true,
  // Zone routes intercept ahead of the legacy Pages project — removing these
  // (and redeploying) rolls the site back to Pages instantly.
  "routes": [
    { "pattern": "siftersearch.com/*", "zone_name": "siftersearch.com" },
    { "pattern": "www.siftersearch.com/*", "zone_name": "siftersearch.com" }
  ],
  "observability": {
    "enabled": true
  }
}
