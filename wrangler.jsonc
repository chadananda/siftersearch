{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "siftersearch",
  // The adapter COMPILES worker/index.js (registered as its workerEntryPoint in astro.config.mjs) into
  // this output, so wrangler deploys the built artifact rather than the source wrapper.
  "main": "dist/_worker.js/index.js",
  "compatibility_date": "2025-11-01",
  "compatibility_flags": ["nodejs_compat"],
  "assets": {
    "binding": "ASSETS",
    "directory": "./dist"
  },
  "workers_dev": true,
  // Zone routes intercept ahead of the legacy Pages project — removing these
  // (and redeploying) rolls the site back to Pages instantly.
  "routes": [
    { "pattern": "siftersearch.com/*", "zone_name": "siftersearch.com" },
    { "pattern": "www.siftersearch.com/*", "zone_name": "siftersearch.com" }
  ],
  // Workers AI binding: Clef / Clef-flash (System-1 decision models, Jev-API compatible) run here with no API token;
  // tower's api/lib/systemone.js reaches them through POST /_s1/run (worker/index.js).
  "ai": { "binding": "AI" },
  // Anís's one history + mail (worker/mail/). Migrations: wrangler d1 migrations apply anis --remote
  "d1_databases": [
    { "binding": "ANIS_DB", "database_name": "anis", "database_id": "b7f3d052-7c71-4a0f-aa84-3532c2feb52d", "migrations_dir": "worker/d1/anis" }
  ],
  // Anís mail (worker/mail/drafting.js): drafts every 5 min, outreach planning hourly, daily digest 14:00 UTC.
  "triggers": { "crons": ["*/5 * * * *", "0 * * * *", "0 14 * * *"] },
  "observability": {
    "enabled": true
  }
}
