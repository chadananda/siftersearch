# PWA generated
public/sw.js
public/workbox-*.js
data/meilisearch-dev/

.claude/*
# A negation cannot re-include a file whose parent DIRECTORY is excluded, so the
# pattern above must exclude the contents (.claude/*), not the directory
# (.claude/). The Stop gate has to travel with the repo: without it a dispatched
# worker ends its turn with acceptance criteria failing and nothing notices.
!.claude/hooks/
!.claude/settings.json
tests/chat/runs/results-*.json

# Entity-pipeline scratch / research data dumps (regenerable; never commit)
/db-*.json
/person-gloss-plan.json
.work/
data/siftersearch-gazetteer.json

# wrangler local runtime state (sqlite WAL/SHM, never committable)
.wrangler/

# --- standard hygiene ---
*conflicted copy*
