#!/bin/bash

# Pre-commit hook for SifterSearch
#
# Complete deployment pipeline - all steps must pass or commit is aborted:
# 1. Run linting (catches style/syntax issues)
# 2. Run unit tests (fast safety check)
# 3. Verify server imports (catches missing dependencies)
# 4. Build client for production
# 5. Deploy site worker (SSR + assets + /api proxy) via scripts/deploy-worker.sh
# 6. Push to GitHub (triggers server auto-update)
# 7. Bump version and update changelog
# 8. Stage version files for commit
#
# Skip with: git commit --no-verify
# Skip lint only (tests STILL run):  SKIP_LINT=1 git commit ...
# Skip all quality checks:           SKIP_CHECKS=1 git commit ...   (last resort — disables the test gate)

set -e

# Non-interactive shells (agents, CI) may lack node on PATH — self-heal with the fnm install
# so `git commit` works bare, without an `export PATH=… &&` prefix wrapping every commit.
command -v node >/dev/null 2>&1 || export PATH="$HOME/.local/share/fnm/node-versions/v24.16.0/installation/bin:$PATH"

# Colors for output
RED='\033[0;31m'
GREEN='\033[0;32m'
YELLOW='\033[1;33m'
BLUE='\033[0;34m'
NC='\033[0m' # No Color

echo -e "${YELLOW}[pre-commit]${NC} Running pre-commit hooks..."

# Get the root of the git repository
ROOT_DIR=$(git rev-parse --show-toplevel)
cd "$ROOT_DIR"

# Check if there are actual code changes (not just version files)
STAGED_FILES=$(git diff --cached --name-only --diff-filter=ACMR | grep -v 'package.json\|changelog.json' || true)
if [ -z "$STAGED_FILES" ]; then
  echo -e "${YELLOW}[pre-commit]${NC} No code changes staged, skipping deployment"
  exit 0
fi

# Load secrets from .env-secrets (source handles KEY="value" format)
if [ -f .env-secrets ]; then
  set -a  # auto-export all variables
  source .env-secrets
  set +a
fi

# ============================================
# PHASE 1: Quality Checks (fail fast)
# ============================================

# SKIP_LINT vs SKIP_CHECKS — the distinction exists because the coarse escape hatch was being used for the
# wrong reason. The repo carries ~266 PRE-EXISTING lint errors, so any commit touching unrelated files needs
# lint bypassed; the only available switch was SKIP_CHECKS=1, which ALSO disables the tests. The result was
# predictable and it happened three times in one session: a commit pushed while the suite reported failures,
# once a temporal-dead-zone bug that would have crashed the snapshot cron on its next run.
#
#   SKIP_LINT=1    → skip ONLY lint. TESTS STILL RUN AND STILL BLOCK.   ← use this one
#   SKIP_CHECKS=1  → skip everything. Now warns loudly about what it is really disabling.
#
# A gate that has to be turned off for an unrelated reason will be turned off, so the fix is to make the
# narrow bypass available rather than to resolve never to use the wide one (2026-08-17).
if [ "$SKIP_CHECKS" = "1" ]; then
  echo -e "${YELLOW}[pre-commit]${NC} SKIP_CHECKS=1 — skipping lint AND TESTS AND import check."
  echo -e "${YELLOW}[pre-commit]${NC} If you only meant to bypass the pre-existing lint errors, use SKIP_LINT=1 instead — it keeps the test gate."
else
  # Run linting
  if [ "$SKIP_LINT" = "1" ]; then
    echo -e "${YELLOW}[pre-commit]${NC} SKIP_LINT=1, skipping linter (tests still run)"
  else
    echo -e "${GREEN}[pre-commit]${NC} Running linter..."
    if ! npm run lint 2>&1; then
      echo -e "${RED}[pre-commit]${NC} Linting failed! Commit aborted."
      echo -e "${YELLOW}[pre-commit]${NC} Pre-existing unrelated errors? SKIP_LINT=1 git commit … (keeps the test gate)"
      exit 1
    fi
    echo -e "${GREEN}[pre-commit]${NC} ✓ Linting passed"
  fi

  # Run unit tests — NOT skippable by SKIP_LINT, deliberately.
  echo -e "${GREEN}[pre-commit]${NC} Running unit tests..."
  if ! npm run test 2>&1; then
    echo -e "${RED}[pre-commit]${NC} Tests failed! Commit aborted."
    exit 1
  fi
  echo -e "${GREEN}[pre-commit]${NC} ✓ Tests passed"

  # Verify server imports (catches missing dependencies). Also catches a module that cannot be IMPORTED,
  # which node --check cannot see — the exact shape of the snapshot-crashing bug mentioned above.
  echo -e "${GREEN}[pre-commit]${NC} Checking server imports..."
  if ! node scripts/check-server-imports.js 2>&1; then
    echo -e "${RED}[pre-commit]${NC} Server import check failed! Commit aborted."
    exit 1
  fi
  echo -e "${GREEN}[pre-commit]${NC} ✓ Server imports OK"
fi

# ============================================
# PHASE 2: Bump Version (BEFORE build so it's baked into client)
# ============================================

echo -e "${BLUE}[pre-commit]${NC} Bumping version..."
# Versioning scheme is [product].[major].[minor], NOT semver. The third
# number is what the user calls "minor" — semver patch. Every code commit
# gets a "minor" bump (the third position), via `bump-version.js patch`.
NEW_VERSION=$(node scripts/bump-version.js patch 2>&1 | tail -1)
echo -e "${GREEN}[pre-commit]${NC} ✓ Version: ${NEW_VERSION}"

# ============================================
# PHASE 3: Build Client for Production (with new version)
# ============================================

echo -e "${BLUE}[pre-commit]${NC} Building client for production..."
# PUBLIC_API_URL is intentionally NOT set: production browser code is same-origin
# ('' → relative /api/*, proxied by the edge worker). SSR falls back to the tunnel origin.
if ! PUBLIC_DEPLOY_SECRET="$DEPLOY_SECRET" npm run build 2>&1; then
  echo -e "${RED}[pre-commit]${NC} Build failed! Commit aborted."
  exit 1
fi
echo -e "${GREEN}[pre-commit]${NC} ✓ Build passed"

# Regenerate changelog with new version
node scripts/generate-changelog.js > /dev/null 2>&1

# Stage version files
git add package.json src/lib/changelog.json

# ============================================
# PHASE 4: Deploy site Worker (SSR + assets + /api proxy) — replaces Pages deploy
# ============================================

if ! bash scripts/deploy-worker.sh 2>&1; then
  echo -e "${RED}[pre-commit]${NC} Worker deployment failed! Commit aborted."
  echo -e "${YELLOW}[pre-commit]${NC} Version was bumped but not deployed. Run: git restore package.json src/lib/changelog.json"
  exit 1
fi
echo -e "${GREEN}[pre-commit]${NC} ✓ Site worker deployed (wrangler deploy)"

# ============================================
# PHASE 5: Push to GitHub (triggers server update)
# ============================================

# We need to complete the commit first, then push
# This is handled by creating a post-commit hook that just pushes

echo -e "${GREEN}[pre-commit]${NC} ✓ All checks passed, deployment ready"
echo -e "${BLUE}[pre-commit]${NC} Client: https://siftersearch.com (v${NEW_VERSION})"
echo -e "${BLUE}[pre-commit]${NC} Server will auto-update when commit is pushed"

# ============================================
# PHASE 6: Production Health Snapshot (non-blocking — informs, never aborts)
# ============================================

echo -e "${BLUE}[pre-commit]${NC} Running production health check..."
if node scripts/health-check.mjs --quick 2>&1; then
  echo -e "${GREEN}[pre-commit]${NC} ✓ Production health: all systems operational"
else
  echo -e "${YELLOW}[pre-commit]${NC} ⚠ Production health issues detected — review output above before shipping"
  echo -e "${YELLOW}[pre-commit]${NC}   Commit is NOT aborted. Address issues or run with SKIP_HEALTH=1 to suppress."
fi
