# SifterSearch Public Configuration
# Non-sensitive defaults - checked into git
# Override with config.yaml or .env-secrets

# ==============================
# Development Mode
# ==============================
# DEV_MODE controls AI providers and library paths:
#   true  → Remote AI APIs (OpenAI, Anthropic), 2 test folders
#   false → Local Ollama, full library
#
# NOT SET HERE - determined by environment:
#   - Dev: defaults to true (safe default in config.js)
#   - Production: PM2 sets DEV_MODE=false via env_production

# ==============================
# Server Ports
# ==============================
API_PORT=7839
APP_PORT=7842
MEILI_HOST=http://localhost:7700
MEILI_HOST_DEV=http://localhost:7701

# ==============================
# Database
# ==============================
# Local development uses embedded SQLite
TURSO_DATABASE_URL=file:./data/sifter.db
# NOTE (2026-09-06): production does NOT use Turso cloud. It runs on Tower-NAS
# against a local SQLite file plus Meilisearch, served through a Cloudflare tunnel.
# The URL below is dead — it returns 401 with TURSO_AUTH_TOKEN and 404 with
# TURSO_TOKEN (that database name no longer exists on the account). It is kept
# only so nobody re-derives it and assumes it works.
#   DEAD: libsql://siftersearch-chadananda.aws-us-west-2.turso.io
# For authoritative corpus numbers use: node scripts/corpus-status.mjs

# ==============================
# Search (Meilisearch)
# ==============================
# Meilisearch RETIRED (storage plan R8, Chad 10-21 "get rid of meilisearch"): false = no client, no startup spawn, no
# outbox deletes, no backup step; search ranks with Qdrant alone (SEARCH_QDRANT=only). The service is stopped and disabled
# on tower; its data stays on /tank. Rollback: true here + `systemctl --user enable --now meilisearch`.
MEILISEARCH_ENABLED=false
# MEILI_HOST determined by DEV_MODE in config.js
SEARCH_MAX_RESULTS=100
SEARCH_SNIPPET_SIZE=160
SEARCH_TIMEOUT_MS=5000
# Qdrant phrase + keyword layers beside Meilisearch for planned search (Anís, site search, API). Type battery 10-12:
# Meili only 59/82 (72%) · + Qdrant phrase,keyword 63/82 (77%) · Qdrant only 64/83 (77%, 2× faster, but exact_phrase
# 10/14 and author_scoped 1/3). 'only' when it matches on those (then retire Meili — Chad 10-04 order).
# Qdrant ranks alone (Meilisearch retirement, Chad 10-20): type battery 66/83 vs 63/83 with Meili, p50 1.6 s vs 4.4 s, p95 4.2 s vs 18 s.
# Rollback: phrase,keyword (Meili still receives writes until the retirement plan's step 5).
SEARCH_QDRANT=only
# Meilisearch writes OFF (retirement step 5, 10-20): it was the largest I/O on /fast though search no longer reads it.
# Site-only scopes still read their frozen Meili indexes until those sites are in Qdrant. Rollback: MEILI_WRITES=on, then
# re-sync rows updated since 2026-10-20 (synced was settled, not pushed).
MEILI_WRITES=off
# PHASE 0 hot layer (storage plan §6.6, Chad 10-21, until the MP44): NEW phrase points go to `phrases_hot` in qdrant-hot
# (RAM disk /srv/qram, port 6335, snapshots every 6 h to /crutch); search merges main + hot. Rollback: delete these two lines
# (search reads main only; units marked upserted=2 are re-sent to main by `indexer.mjs --qdrant` after resetting them).
QDRANT_HOT_URL=http://127.0.0.1:6335
QDRANT_HOT_PHRASES=phrases_hot
# Authority ranking position in Meilisearch rules (1-7):
# 2 = after words (HIGH priority - primary sources surface even with weaker keyword match)
# 4 = after proximity (DEFAULT - authority matters but keywords dominate)
# 6 = after sort (LOW - authority is tiebreaker only)
AUTHORITY_RANK_POSITION=2

# ==============================
# AI/LLM Configuration
# ==============================
# These are DEV_MODE defaults (remote APIs)
# Production defaults to Ollama - see api/lib/config.js

# Embeddings (always OpenAI for consistency)
# text-embedding-3-large (3072 dims) for maximum semantic quality
# For a classical religious library, higher dimensions capture nuanced spiritual meanings
EMBEDDING_MODEL=text-embedding-3-large
EMBEDDING_DIMENSIONS=512

# Chat/orchestration (dev: OpenAI, prod: Ollama)
CHAT_LLM_PROVIDER=openai
CHAT_LLM_MODEL=gpt-4o
CHAT_LLM_TEMPERATURE=0.7
CHAT_LLM_MAX_TOKENS=1000

# Search enhancement (dev: OpenAI, prod: Ollama)
SEARCH_LLM_PROVIDER=openai
SEARCH_LLM_MODEL=gpt-4o-mini
SEARCH_LLM_TEMPERATURE=0.2
SEARCH_LLM_MAX_TOKENS=500

# Document processing (dev: Anthropic, prod: Ollama)
DOC_LLM_PROVIDER=anthropic
DOC_LLM_MODEL=claude-3-haiku-20240307
DOC_LLM_TEMPERATURE=0.1
DOC_LLM_MAX_TOKENS=2000

# Local Ollama endpoint (for production)
OLLAMA_HOST=http://localhost:11434
OLLAMA_CHAT_MODEL=qwen2.5:32b
OLLAMA_SEARCH_MODEL=qwen2.5:14b

# LM Studio (Local Network - Tailscale)
# Used for Arabic/Farsi document segmentation (free, local inference)
SEGMENTATION_LLM_PROVIDER=anthropic
SEGMENTATION_LLM_MODEL=claude-haiku-5-5

# ==============================
# Authentication
# ==============================
JWT_ACCESS_EXPIRES=15m
JWT_REFRESH_EXPIRES_DAYS=90

# Clerk (public key only)
PUBLIC_CLERK_PUBLISHABLE_KEY=pk_test_cHJvcGVyLXB5dGhvbi0zNi5jbGVyay5hY2NvdW50cy5kZXYk

# Google sign-in (One Tap + button). Client ID is public by design; the secret stays in .env-secrets.
PUBLIC_GOOGLE_CLIENT_ID=755984862186-5fkhm8tqqmn0bbgv0hob31i3gcre5nbh.apps.googleusercontent.com

# ==============================
# Email Configuration
# ==============================
# Provider: resend, sendgrid, or console (default for dev)
EMAIL_PROVIDER=console
EMAIL_FROM=SifterSearch <noreply@siftersearch.com>

# ==============================
# Background Jobs
# ==============================
JOB_POLL_INTERVAL=5000
JOB_CLEANUP_INTERVAL=3600000
MAX_CONCURRENT_JOBS=2

# ==============================
# Storage Paths
# ==============================
AUDIO_DIR=./data/audio
TRANSLATION_DIR=./data/translations

# ==============================
# CORS Configuration
# ==============================
CORS_ORIGINS=http://localhost:7842,http://localhost:4321,https://siftersearch.com,https://www.siftersearch.com,https://siftersearch.pages.dev

# ==============================
# Rate Limiting
# ==============================
ENABLE_RATE_LIMITING=false
RATE_LIMIT_MAX=100
RATE_LIMIT_WINDOW_MS=60000

# Per-tier limits (requests per minute)
RATE_LIMIT_VERIFIED=10
RATE_LIMIT_APPROVED=60
RATE_LIMIT_PATRON=100
RATE_LIMIT_ADMIN=1000

# ==============================
# Logging
# ==============================
LOG_LEVEL=info

# ==============================
# Application Metadata
# ==============================
APP_NAME=SifterSearch
APP_VERSION=1.0.0
APP_URL=https://siftersearch.com
APP_URL_DEV=http://localhost:7842
API_URL=https://api.siftersearch.com
API_URL_DEV=http://localhost:3001
SITE_DOMAIN=siftersearch.com
SITE_TITLE=SifterSearch - AI-Powered Interfaith Library

# ==============================
# Analytics
# ==============================
POSTHOG_SITE_KEY=phc_AXeH9HMarlETPWG2IyFbagImec37BU02S9tUsJLBMII

# ==============================
# Public Search API (v1)
# ==============================
# For external applications to access the search API
# API keys should be set in .env-secrets as comma-separated values:
# PUBLIC_API_KEYS=key1,key2,key3
# Generate keys with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
PUBLIC_API_RATE_LIMIT=1000
PUBLIC_API_MAX_RESULTS=50

# Client-side API key — siftersearch.com home-page chat is itself a client
# of the public API (same shape an external customer-site chatbot will use).
# Vite exposes any PUBLIC_-prefixed var to the browser bundle. The value
# below must also appear in PUBLIC_API_KEYS in .env-secrets so the server
# accepts it.
PUBLIC_SIFTER_API_KEY=a9b228276d355e3a053223bfd64cd5546792c65053905606fef5dfe68fab7a31

# ==============================
# Auto-Deploy
# ==============================
# Secret for client to trigger server updates on version mismatch
# Set same value in .env-secrets for both client and server
# Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
# DEPLOY_SECRET is set in .env-secrets
PUBLIC_DEPLOY_SECRET=986ee41ca05f872492bacc12eb7f4361406fc418b7acf80bb429ab9eea75749f

# ==============================
# Entity Extraction Pipeline
# ==============================
# Tiered model selection — higher authority docs get better extraction.
# Thresholds match doc_priority values in config/doc-tier-priority.json:
#   >= EXTRACTION_TIER_HIGH: doctrinal/revelatory (priority 400+)
#       revealed(550), central_figure(500), authorized_interpretation(480),
#       primary_scripture_other(480), tradition_doctrinal(440)
#   >= EXTRACTION_TIER_MID: historical/scholarly (priority 100-399)
#       tradition_authoritative(380), approved_history(320-350), scholarly(250),
#       secondary(150), generic Bahá'í(200), default fallback(100)
#   <  EXTRACTION_TIER_MID: legislative/reference (priority < 100)
#       institutional(80), reference(60)
EXTRACTION_TIER_HIGH=400
EXTRACTION_TIER_MID=100
EXTRACTION_MODEL_HIGH=deepseek-v4-flash
EXTRACTION_MODEL_MID=deepseek-v4-flash
EXTRACTION_MODEL_LOW=deepseek-v4-flash

# Promoter voting models (cheapest → detail → arbiter on disagreement)
PROMOTER_FAST_MODEL=deepseek-v4-flash
PROMOTER_DETAIL_MODEL=claude-haiku-4-5-20251001
PROMOTER_ARBITER_MODEL=deepseek-v4-pro

# Validator model (Haiku QA pass)
VALIDATOR_MODEL=claude-haiku-4-5-20251001

# Monthly extraction budget in USD before halting.
# Full corpus ~4.45M paras: ~800K at v4-pro ≈ $2,400 + ~3.6M at v4-flash ≈ $6,120
# Set to pace over 3 months; raise once extraction quality is confirmed.
EXTRACTION_BUDGET_USD=3000

# Anís researcher (api/lib/assistant/researcher.js): channels where Haiku 5.5 plans the research and Sonnet 5.5 writes.
# Battery 10-19: beat Perplexity on 10/10 real questions (mean 7.45 vs old pipeline 5.0). Chat stays on the fast path.
ANIS_RESEARCH=email
